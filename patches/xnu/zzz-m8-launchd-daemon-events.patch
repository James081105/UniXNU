@@ -188,6 +188,143 @@
 
 #include <mach/exclaves.h>
 
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+/* M8 wants the original launchd and the daemons that followed it, both read off
+ * a guest channel (milestones.py:1512-1513 for the probes, :2424-2463 for the
+ * milestone).  The two emitters below are ONE change and must land together:
+ * the veto m8.veto.mockfs_pid1_as_launchd fires when launchd.running arrives
+ * WITHOUT daemon.spawned, so shipping one of the pair turns M8 from UNVERIFIED
+ * into FAIL and makes the release verdict worse.  That is the same shape as the
+ * device_enumeration_without_readback veto, and the same rule applies: emit
+ * both or neither.
+ *
+ * Guarded on XNU_OWNER_CACHE_MOUNT because that is the switch that reaches
+ * kern_exec.o at all.  build-xnu-4k-baseline.sh:466 passes it as
+ * kern_exec.o_CFLAGS_ADD, and it is set only by qemu_root_defconfig:33 -- the
+ * same config that sets CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=y at :47, which is
+ * what puts libNativeVirtioConsole.a on the kernel link with -Wl,-force_load
+ * (:674-678).  So this code exists exactly where the port exists, and a config
+ * with the mount off compiles it out instead of failing to link.
+ *
+ * A STRONG extern, deliberately, for the reason offline-owner-systemos-mount.patch
+ * records at length: on build 41330622788 a __attribute__((weak_import))
+ * reference resolved to null and dropped two records behind a green build.  A
+ * strong reference makes the definition load-bearing, so a missing archive
+ * fails the link naming the symbol rather than silencing the records.  There
+ * is therefore no `if (native_console_report)` test anywhere in this patch:
+ * liveness is answered by the call's return status, and a null check cannot
+ * tell "the port is not there yet" apart from "the symbol was never linked",
+ * which have opposite remedies. */
+extern int native_console_report(const void *, size_t);
+
+/* The longest record this block can build, NUL included.  The worst case is 98
+ * bytes -- 32 prefix + 10 pid digits + 9 middle + MAXCOMLEN comm + 30 suffix --
+ * so this is close to twice it and the bounded copies in
+ * native_m8_report_daemon() can only truncate, never overrun. */
+#define M8_RECORD_MAX 192
+
+static char const m8_daemon_prefix[] = "{\"event\":\"daemon.spawned\",\"pid\":";
+static char const m8_daemon_middle[] = ",\"comm\":\"";
+static char const m8_daemon_suffix[] = "\",\"source\":\"XNU.__mac_execve\"}\n";
+
+/* One daemon.spawned record per boot.  The site is per-exec -- this is
+ * __mac_execve()'s `if (!error)` block -- and the project measured it at 75
+ * or more sends in a single boot.  Each of those can cost a full 2000 ms
+ * deadline on a channel whose send() waits synchronously
+ * (NativeVirtioConsole.cpp:226 sets the deadline, :250 is the wait), so an
+ * unbounded emitter here is 75 chances to hold up an exec path for two
+ * seconds each, and the gate keeps only the first record for the event name
+ * regardless.
+ *
+ * Set BEFORE the emit and never cleared: a record that is in flight is a
+ * record that has been reported, and a re-entrant path must not queue a
+ * second one behind it.  launchd.running needs no such flag -- see the note
+ * at its own emit site. */
+static int native_m8_daemon_reported = 0;
+
+/* The one daemon.spawned record, for the first successful exec of the boot.
+ *
+ * Called from __mac_execve()'s `if (!error)` block, which is the only place in
+ * that function where the exec has succeeded AND the new process identity can
+ * be named: `p` is the switched proc (proc_exec_switch_task, the first
+ * statement of the block) and p_comm was written by set_proc_name() inside
+ * exec_mach_imgact().  What is deliberately NOT read here is imgp->ip_ndp:
+ * exec_activate_image() has already called nameidone() on it, so it is freed.
+ * p_comm is the proc's own name, it is what the kernel ring prints as
+ * name[pid], and set_proc_name() NUL-terminates it.
+ *
+ * Hand-formatted rather than snprintf: this translation unit does not include
+ * the header that declares it, and guessing wrong is a 40-minute build to
+ * discover.  Every byte written is bounded by M8_RECORD_MAX and the record
+ * always ends with the newline the host's line split needs.
+ *
+ * The length handed to the port is the fill count, not sizeof(record): this
+ * buffer is built at run time, so sizeof would be the whole 192.  The static
+ * records elsewhere in this patch do use sizeof(...) - 1, because for an array
+ * that IS the record's own length. */
+static void
+native_m8_report_daemon(proc_t p)
+{
+	char record[M8_RECORD_MAX];
+	int at = 0;
+	int index;
+
+	/* PID 1 is the original launchd record emitted by load_init_program().
+	 * M8's second event must describe a later daemon, so leave launchd out of
+	 * this one-shot emitter and wait for the first successful exec with pid > 1. */
+	if (p->p_pid <= 1) {
+		return;
+	}
+	if (native_m8_daemon_reported) {
+		return;                     /* one daemon.spawned, one record */
+	}
+
+	for (index = 0; m8_daemon_prefix[index] != '\0' && at < M8_RECORD_MAX - 1; index++) {
+		record[at++] = m8_daemon_prefix[index];
+	}
+	{
+		/* pid_t is signed and a negative pid is not a thing; clamping to 0
+		 * keeps the record a number rather than a false one. */
+		unsigned int value = (p->p_pid > 0) ? (unsigned int)p->p_pid : 0u;
+		char digits[12];
+		int count = 0;
+		do {
+			digits[count++] = (char)('0' + (int)(value % 10u));
+			value /= 10u;
+		} while (value != 0 && count < (int)sizeof(digits));
+		while (count > 0 && at < M8_RECORD_MAX - 1) {
+			record[at++] = digits[--count];
+		}
+	}
+	for (index = 0; m8_daemon_middle[index] != '\0' && at < M8_RECORD_MAX - 1; index++) {
+		record[at++] = m8_daemon_middle[index];
+	}
+	/* Substituted rather than escaped: a quote or a backslash in a process
+	 * name would end the JSON string early and put a record on the wire that
+	 * no parser accepts, which reads on the host as "the guest never did it" --
+	 * the same class of silent failure as a truncated record. */
+	for (index = 0; index < MAXCOMLEN && at < M8_RECORD_MAX - 2; index++) {
+		char c = p->p_comm[index];
+		if (c == '\0') {
+			break;
+		}
+		if (c == '"' || c == '\\' || c < ' ' || c > '~') {
+			c = '?';
+		}
+		record[at++] = c;
+	}
+	for (index = 0; m8_daemon_suffix[index] != '\0' && at < M8_RECORD_MAX - 1; index++) {
+		record[at++] = m8_daemon_suffix[index];
+	}
+	record[at] = '\0';
+	/* Claimed before the call, not after: the record is on its way out, and
+	 * a path that re-enters this function while send() waits must not queue
+	 * a second one behind it.  The length is the fill count -- this buffer is
+	 * built at run time, so sizeof would be the whole 192. */
+	native_m8_daemon_reported = 1;
+	native_console_report(record, (size_t)at);
+}
+#endif /* XNU_OWNER_CACHE_MOUNT */
 extern boolean_t vm_darkwake_mode;
 
 /* enable crash reports on various exec failures */
@@ -5285,16 +5422,19 @@ __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 
 	if (!error) {
 		exec_done = TRUE;
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+		native_m8_report_daemon(p);
+#endif
 		assert(imgp->ip_new_thread != NULL);
 
 		exec_resettextvp(p, imgp);
 		/*
 		 * Enable new task IPC access if exec_activate_image() returned an
 		 * active task. (Checks active bit in ipc_task_enable() under lock).
 		 * Must enable after resettextvp so that task port policies are not evaluated
 		 * until the csblob in the textvp is accurately reflected.
 		 */
 		ipc_task_enable(new_task);
 		error = process_signature(p, imgp);
 	}

@@ -8330,6 +8470,47 @@ load_init_program(proc_t p)
 		printf("load_init_program: attempting to load %s\n", init_programs[i]);
 		error = load_init_program_at_path(p, (user_addr_t)scratch_addr, init_programs[i], init_envp);
 		if (!error) {
+#if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
+			/* PID 1 is now running the init program it successfully exec'd.
+			 * Emitted INSIDE the success branch and not before the call:
+			 * a record emitted before load_init_program_at_path() would
+			 * claim a launchd that then failed to load, and the panic()
+			 * four lines below is exactly what happens when every entry
+			 * fails.
+			 *
+			 * The program is named only when the entry that loaded is the
+			 * unconditional one.  init_programs[]'s last entry is
+			 * /sbin/launchd and the two above it sit behind #if DEBUG and
+			 * #if DEVELOPMENT || DEBUG, so on an Apple-internal image a
+			 * different entry can succeed and naming /sbin/launchd would
+			 * then be a false statement in the evidence.  MEASURED on this
+			 * board's ring: "attempting to load
+			 * /usr/appleinternal/sbin/launchd.development" at t=64.879,
+			 * then "attempting to load /sbin/launchd" at t=65.008, then
+			 * "[1(launchd)]" at t=66.579 -- so the last entry is the one
+			 * that loads here, and that same trace settles the config
+			 * question: DEVELOPMENT is set and DEBUG is not.
+			 *
+			 * Bounded by construction rather than by a flag, which is why
+			 * this site carries no state.  load_init_program() runs once per
+			 * boot, from bsd_init(); the loop returns on the first entry
+			 * that loads, so at most one iteration reaches this point; and
+			 * the two records below are mutually exclusive by the if/else.
+			 * One record per boot therefore needs nothing to enforce it,
+			 * unlike daemon.spawned, whose site runs once per exec. */
+			if (i == sizeof(init_programs) / sizeof(init_programs[0]) - 1) {
+				static char const launchd_record[] =
+				    "{\"event\":\"launchd.running\",\"pid\":1,"
+				    "\"program\":\"/sbin/launchd\","
+				    "\"source\":\"XNU.load_init_program\"}\n";
+				native_console_report(launchd_record, sizeof(launchd_record) - 1);
+			} else {
+				static char const launchd_record[] =
+				    "{\"event\":\"launchd.running\",\"pid\":1,"
+				    "\"source\":\"XNU.load_init_program\"}\n";
+				native_console_report(launchd_record, sizeof(launchd_record) - 1);
+			}
+#endif
 			return;
 		} else if (error != ENOENT) {
 			printf("load_init_program: failed loading %s: errno %d\n", init_programs[i], error);
