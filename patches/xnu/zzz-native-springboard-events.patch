+		{
+			extern int native_console_report(const void *, size_t);
+			enum { kMaxExitRecords = 65536 };
+			static char const exit_prefix[] =
+			    "{\"event\":\"exit.seen\",\"n\":";
+			static char const exit_middle[] = ",\"comm\":\"";
+			static char const exit_code_middle[] = "\",\"code\":";
+			static char const exit_suffix[] =
+			    ",\"source\":\"XNU.exit_with_reason\"}\n";
+			static unsigned native_exit_records = 0;
+			char record[128];
+			unsigned used = 0, i = 0, safe = 1;
+			char c;
+			while (i < sizeof(p->p_comm) && (c = p->p_comm[i]) != 0) {
+				if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+				    || (c >= '0' && c <= '9') || c == '.' || c == '_'
+				    || c == '-')) {
+					safe = 0;
+				}
+				++i;
+			}
+			if (native_exit_records >= kMaxExitRecords) {
+				extern int native_console_report(const void *, size_t);
+				static char const cap_note[] =
+				    "{\"event\":\"exit.saturated\","
+				    "\"source\":\"XNU.exit_with_reason\"}\n";
+				static int native_exit_records_cap_reported = 0;
+				if (!native_exit_records_cap_reported) {
+					native_exit_records_cap_reported = 1;
+					native_console_report(cap_note, sizeof(cap_note) - 1);
+				}
+			}
+			if (native_exit_records < kMaxExitRecords && safe && i != 0) {
+				unsigned n, digits = 0;
+				char text[8];
+				++native_exit_records;
+				n = native_exit_records;
+				while (used < sizeof(exit_prefix) - 1) {
+					record[used] = exit_prefix[used];
+					++used;
+				}
+				if (!n) {
+					text[digits++] = '0';
+				}
+				while (n && digits < sizeof(text)) {
+					text[digits++] = (char)('0' + n % 10);
+					n /= 10;
+				}
+				while (digits && used < sizeof(record) - 1) {
+					record[used++] = text[--digits];
+				}
+				for (unsigned k = 0; k < sizeof(exit_middle) - 1
+				    && used < sizeof(record) - 1; ++k) {
+					record[used++] = exit_middle[k];
+				}
+				for (unsigned k = 0; k < i && used < sizeof(record) - 1; ++k) {
+					record[used++] = p->p_comm[k];
+				}
+				/* THE EXIT STATUS, because twenty-nine process names with no
+				 * status is a list and not a diagnosis.  MEASURED 2026-11-04
+				 * on build 41690023024: fairplayd.A2 ran THREE times in one
+				 * boot (n=25, 26, 29) and was the last thing that ran before
+				 * the boot stalled.  A daemon that runs three times is usually
+				 * one that failed and was relaunched, and 'usually' is exactly
+				 * what this field is for.
+				 *
+				 * rv is the wait status the kernel is about to hand the
+				 * parent, so it is the kernel's own number and not an
+				 * interpretation of it.  Negative is emitted with a sign: a
+				 * process killed by a signal reports a negative status.
+				 *
+				 * Eleven digits is the worst case for a signed 32-bit int, and
+				 * the record still lands inside the 128-byte buffer: 25 prefix
+				 * + 2 index + 9 + 16 comm + 9 + 11 code + 34 suffix is 106,
+				 * plus the NUL. */
+				for (unsigned k = 0; k < sizeof(exit_code_middle) - 1
+				    && used < sizeof(record) - 1; ++k) {
+					record[used++] = exit_code_middle[k];
+				}
