+					}
+					if (!mag) {
+						ctext[cdigits++] = '0';
+					}
+					while (mag && cdigits < sizeof(ctext)) {
+						ctext[cdigits++] = (char)('0' + mag % 10);
+						mag /= 10;
+					}
+					while (cdigits && used < sizeof(record) - 1) {
+						record[used++] = ctext[--cdigits];
+					}
+				}
+				for (unsigned k = 0; k < sizeof(exit_suffix) - 1
+				    && used < sizeof(record) - 1; ++k) {
+					record[used++] = exit_suffix[k];
+				}
+				record[used] = 0;
+				native_console_report(record, used);
+			}
+		}
+#endif
 
