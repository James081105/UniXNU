diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 34c921b..def1edb 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -5116,6 +5116,419 @@ openat_internal(vfs_context_t ctx, user_addr_t path, int flags, int mode,
 
 	error = open1at(ctx, ndp, flags, vap, NULL, NULL, retval, fd, AUTH_OPEN_NOAUTHFD);
 
+#if defined(XNU_NATIVE_VIRTIO_CONSOLE) && XNU_NATIVE_VIRTIO_CONSOLE
+	/* Report the launchd job files this guest opens, on the channel the
+	 * acceptance gate reads.
+	 *
+	 * WHY THIS EMITTER EXISTS.  Interval 45 read
+	 * /System/Library/LaunchDaemons/com.apple.SpringBoard.plist byte-exact out
+	 * of the guest's root volume (2634 bytes, sha256
+	 * a071265c26b9415973c8bbab8d99fcff6e347d6b7831b9f059903ea63dd835fe) and it
+	 * carries RunAtLoad=TRUE, KeepAlive=TRUE, POSIXSpawnType=App.  So launchd
+	 * was told to start this job at boot and did not.
+	 *
+	 * REVISION 2 CORRECTS REVISION 1's ACCOUNT OF THE SEPARATOR, because
+	 * revision 1's header is now known to be wrong in a way that matters.
+	 * Revision 1 said POSIXSpawnType=App was "the one key that separates them
+	 * perfectly": seven jobs carry it, zero of the 92 that ran have it.
+	 * Interval 47's live boot then produced 105 spawns, and the table behind
+	 * them says
+	 *
+	 *     Standard (absent)  29 ran / 207 not-ran
+	 *     Adaptive           28 ran / 165 not-ran
+	 *     Interactive        35 ran /  41 not-ran
+	 *     App                 0 ran /   7 not-ran
+	 *     Background          0 ran /   5 not-ran
+	 *
+	 * so App is NOT special.  App and Background are BOTH zero-for-92, and
+	 * those are the two SESSION-SCOPED spawn types while the three that
+	 * launched are boot-scoped.  The question is therefore not "why does
+	 * launchd decline App" but "what does a session-scoped launch require that
+	 * this guest never provides" -- and SpringBoard, the job that would
+	 * establish the session, is itself session-scoped.  That is a correlation
+	 * over 12 jobs with a mechanism that fits, not a mechanism, and this
+	 * emitter exists to supply the half of it the spawn stream cannot.
+	 *
+	 * The other candidate was refuted with a live control.  SpringBoard's
+	 * LimitLoadFromHardware={"osenvironment":["diagnostics"]} is carried by
+	 * exactly one other job, com.apple.logd.plist, which SPAWNED in the same
+	 * boot (spawn.seen n=11) while SpringBoard did not.  A key that produces
+	 * both outcomes in one run is not a cause.
+	 *
+	 * What it can supply is the other half: whether launchd ever READS the
+	 * REVISION 3 RECORDS WHAT REVISION 2 MEASURED AND WHAT IT REFUTED.
+	 * Revision 2 widened the general record's gate to
+	 * `in_a_job_dir || launchd_is_the_caller` and added abs and comm
+	 * fields, on one sample: three job.open records against 105 spawns
+	 * at 08:50.  At 09:15 the same log carried 154 records against 222
+	 * spawns, errno {0: 152, 2: 2}, so the general record was measuring
+	 * opens correctly all along and the widening comes out.  152 of 154
+	 * opens matched an absolute prefix, which refutes the
+	 * relative-openat hypothesis directly rather than by absence of
+	 * evidence.
+	 *
+	 * What the 154 records DID find is the reason this revision exists,
+	 * and it contradicts the path named in the first paragraph above:
+	 * com.apple.SpringBoard.plist is NOT among them, while the targeted
+	 * basename record fired with err:0.  The general record needs the
+	 * full path to start with one of six job directories, so launchd
+	 * opened SpringBoard's job file successfully from a directory that
+	 * is none of the six.  Either the path above is not the path
+	 * launchd uses, or the union mount presents it under a spelling the
+	 * six literals do not cover.  Both are answerable, and the field
+	 * that answers them is now emitted: the targeted record carries the
+	 * full path it was handed, which is the one thing revision 2 had in
+	 * its probe buffer and threw away.
+	 * file.  "Never opened" and "opened and declined" are different defects
+	 * with different fixes, and this is the only instrument that can tell them
+	 * apart, because the kernel's own dispatcher accepts exactly one message
+	 * type ("type":"install.request") and there is no way to ask launchd
+	 * anything.
+	 *
+	 * THE SITE.  openat_internal() is the single funnel for open() and
+	 * openat(): open_nocancel and openat_nocancel both land here.  It holds
+	 * `user_addr_t path` directly, so the filter is one bounded copyinstr
+	 * rather than a vnode_getpath() on every open in the system -- that
+	 * function walks the parent chain and allocates, and putting it in front
+	 * of every open would cost more than the record is worth.
+	 *
+	 * AFTER open1at(), NOT BEFORE, and that is deliberate: the errno is part of
+	 * the measurement and it is IN the record.  "launchd tried to open
+	 * SpringBoard's plist and got ENOENT" and "launchd tried and succeeded" are
+	 * different findings, and a pre-namei emitter cannot tell them apart.
+	 * `path` is a parameter of this function and stays valid for its whole
+	 * body; `error` is this function's own local, assigned two lines up.
+	 *
+	 * RE-ENTRANCY.  The counters are claimed before the call, not after: the
+	 * record is on its way out, and a path that re-enters this function while
+	 * send() waits must not queue a second one behind it.
+	 *
+	 * SANITISATION.  The job name comes from user memory, so every byte is
+	 * checked against [A-Za-z0-9._-] before it is emitted.  Not tidiness: this
+	 * record is hand-assembled JSON with no escaping, and a name carrying a
+	 * quote or a backslash would put a record on the wire no parser accepts.
+	 * Refusing to emit is a silence, which is already the state; emitting
+	 * garbage is a false result.  The SpringBoard check compares against a
+	 * literal and so cannot be unsafe by construction, which is why the
+	 * targeted record is emitted without a byte scan.
+	 *
+	 * THE SEGFLG GUARD, and what it actually prevents.  Revision 1 of this
+	 * patch described the guard in its comment and did not write it, which a
+	 * review caught.  The stated mechanism was wrong too: copyinstr on a kernel
+	 * address does NOT fault.  copy_validate() (osfmk/arm64/copyio.c:141-147)
+	 * returns EFAULT when the source falls outside [vm_map_min, vm_map_max] of
+	 * the current map, and a kernel address is far above any user map's max;
+	 * is_kernel_to_kernel_copy() (:169-172) returns EFAULT as well because
+	 * copyinstr never sets COPYIO_ALLOW_KERNEL_TO_KERNEL.  So the real
+	 * consequence of an unguarded kernel-space caller is a silently dropped
+	 * record -- which is exactly the failure this patch exists to prevent, and
+	 * the reason the guard is here anyway.  UIO_SEG_IS_USER_SPACE() rather than
+	 * `segflg == UIO_USERSPACE` because that is XNU's own form for this
+	 * decision (bsd/sys/uio.h:130) and it also accepts the 32-bit userspace
+	 * segments.
+	 *
+	 * THE PROBE SIZE, and why 256.  Revision 1 used 96, and the whole emitter
+	 * -- including the targeted SpringBoard check -- sat inside
+	 * `copyinstr(...) == 0`.  A path longer than 95 bytes returns ENAMETOOLONG
+	 * and dropped everything, so the single most valuable record in the patch
+	 * sat behind the same bound as the noise.  256 bytes of stack is free on
+	 * this path (openat_internal already kallocs a struct nameidata) and
+	 * removes the class of failure.
+	 *
+	 * NO snprintf, and static strings only, for the reason the mount emitter
+	 * gives: a formatted value is a value that can disagree with what happened.
+	 * The record number and the errno are assembled by hand, most significant
+	 * digit first. */
+	if (UIO_SEG_IS_USER_SPACE(segflg)) {
+		extern int native_console_report(const void *, size_t);
+		enum { kMaxJobOpenRecords = 512, kJobOpenProbe = 256 };
+		static char const job_open_prefix[] =
+		    "{\"event\":\"job.open\",\"n\":";
+		static char const job_open_middle[] = ",\"job\":\"";
+		static char const job_open_err[] = "\",\"err\":";
+		static char const job_open_suffix[] =
+		    ",\"source\":\"XNU.openat_internal\"}" "\n";
+		static char const springboard_prefix[] =
+		    "{\"event\":\"job.springboard_open\",\"err\":";
+		static char const springboard_suffix[] =
+		    ",\"source\":\"XNU.openat_internal\"}" "\n";
+		/* REVISION 3.  THE PATH, and why it is in the TARGETED
+		 * record and not the general one.  Measured 2026-11-04
+		 * on build 41788097516: 154 general job.open records,
+		 * and com.apple.SpringBoard.plist is NOT among them,
+		 * while this targeted record fired with err:0.  The
+		 * general record requires the full path to begin with
+		 * one of six job directories, so the only consistent
+		 * reading is that launchd opened SpringBoard's job file
+		 * from a directory that is none of the six.  That is
+		 * the first hard evidence for the two-volume split the
+		 * volume scan predicted, and the field that settles
+		 * WHERE the file lives.
+		 *
+		 * It goes here rather than in the general record
+		 * because this record is bounded to one emission and
+		 * the general one is not: 154 records x a 256-byte
+		 * path would be 39 KB of channel traffic to answer a
+		 * question one path answers.
+		 *
+		 * The bytes are scanned against [A-Za-z0-9._-/] rather
+		 * than the general record's [A-Za-z0-9._-], because a
+		 * path without '/' is not a path.  A byte outside that
+		 * set still suppresses the path and keeps the errno,
+		 * which is the same trade the general record makes: a
+		 * silence is already the state, a malformed record is
+		 * not. */
+		static char const springboard_path[] = ",\"path\":\"";
+		static char const springboard_name[] = "com.apple.SpringBoard.plist";
+		/* Both arms of the mount.  offline-owner-systemos-mount.patch:102-116
+		 * mounts the owner cache at "/" when XNU_OWNER_UNION_SYSTEMOS is 1
+		 * and at "/private/preboot" when it is 0, and
+		 * build-xnu-4k-baseline.sh:438 defaults the switch to 0.  Interval
+		 * 42's measured system.mount record says "mountpoint":"/", so the
+		 * union arm is the live one on the build that produced it -- but a
+		 * capture that shows zero job.open records must not be ambiguous
+		 * between "launchd opened no job files" and "the prefix list was
+		 * wrong", so both arms are matched.  Six strings, and the comment in
+		 * the mount patch names both, so the code has to as well. */
+		static char const *const job_dirs[] = {
+			"/System/Library/LaunchDaemons/",
+			"/System/Library/LaunchAgents/",
+			"/System/Library/NanoLaunchDaemons/",
+			"/private/preboot/System/Library/LaunchDaemons/",
+			"/private/preboot/System/Library/LaunchAgents/",
+			"/private/preboot/System/Library/NanoLaunchDaemons/",
+		};
+		static unsigned native_job_open_records = 0;
+		static unsigned native_springboard_reported = 0;
+		char probe[kJobOpenProbe];
+		char const *base = probe;
+		vm_size_t copied = 0;
+		int in_a_job_dir = 0;
+		/* XNU's BSD layer returns positive errno.  A negative would render
+		 * as a large unsigned here, which is a distinguishable "this is not
+		 * an errno" rather than a wrong errno -- and clamping it to zero
+		 * would silently turn "some other failure" into "no failure". */
+		unsigned err_no = (unsigned)error;
+		/* Revision 2 declared launchd_is_the_caller here for the
+		 * comm arm.  Revision 3 removed the arm; see the note
+		 * above the targeted record. */
+
+		/* Whatever copyinstr returns, terminate.  ENAMETOOLONG leaves the
+		 * buffer full and unterminated, and a comparison over an
+		 * unterminated buffer reads past its end. */
+		probe[sizeof(probe) - 1] = 0;
+		if (copyinstr(path, probe, sizeof(probe), &copied) == 0) {
+			/* The last path component.  Only meaningful when the whole
+			 * path fitted, which the == 0 above establishes. */
+			for (int i = 0; probe[i]; ++i) {
+				if (probe[i] == '/') {
+					base = &probe[i + 1];
+				}
+			}
+
+			/* Is this under one of the job directories?  Matched exactly
+			 * rather than by substring, because a substring match would
+			 * also fire on a path that merely mentions the directory name,
+			 * and a record that fires on the wrong path is worse than no
+			 * record. */
+			for (unsigned d = 0;
+			    d < sizeof(job_dirs) / sizeof(job_dirs[0]); ++d) {
+				char const *lit = job_dirs[d];
+				unsigned k = 0;
+				while (lit[k] && probe[k] == lit[k]) {
+					++k;
+				}
+				if (lit[k] == 0) {
+					in_a_job_dir = 1;
+				}
+			}
+
+			/* REVISION 3.  WHAT REVISION 2 GOT WRONG, and what it
+			 * got right.  Revision 2 widened this gate to
+			 * `in_a_job_dir || launchd_is_the_caller` and scanned
+			 * the caller's comm, on one sample: 08:50 on build
+			 * 41788097516 showed three job.open records against
+			 * 105 spawns, and that was read as the prefix filter
+			 * dropping relative opens.
+			 *
+			 * At 09:15 the same log carried 154 records against
+			 * 222 spawns, errno {0: 152, 2: 2}.  The general record
+			 * was measuring opens correctly all along; the boot had
+			 * not reached bulk job discovery yet.  152 of 154 opens
+			 * matched an absolute prefix, which refutes the
+			 * relative-openat hypothesis directly.  So the comm arm,
+			 * the widened gate and this revision's premise all come
+			 * out, and the gate is `in_a_job_dir` again.
+			 *
+			 * The 154 records did find something, and it is why
+			 * this revision exists: com.apple.SpringBoard.plist is
+			 * NOT among them, while the targeted basename record
+			 * below fired with err:0.  The general record needs the
+			 * full path to start with one of six job directories,
+			 * so SpringBoard's job file was opened successfully from
+			 * a directory that is none of the six.  The answer was
+			 * already in the probe buffer; it was not printed.
+			 *
+			 * This is the fifth time this project measured too early
+			 * and read the result as a defect in the instrument.  A
+			 * low count on a live boot is a statement about the
+			 * boot's progress until proven otherwise. */
+			/* THE TARGETED RECORD.  Whatever the directory, whatever the
+			 * prefix, relative or absolute: if the thing being opened IS
+			 * SpringBoard's job file then that is the answer, and it is
+			 * checked before the prefix test so a path outside the six
+			 * watched directories still reports.  Bounded to one, because
+			 * the second and later opens of the same file add nothing to
+			 * "did it ever open this". */
+			if (!native_springboard_reported) {
+				unsigned k = 0;
+				while (springboard_name[k]
+				    && base[k] == springboard_name[k]) {
+					++k;
+				}
+				if (springboard_name[k] == 0 && base[k] == 0) {
+					/* 192 held the errno and two static strings with room
+					 * to spare.  A 256-byte path does not fit in that,
+					 * and a truncated path is worse than none -- it would
+					 * name a directory that is not the one the file came
+					 * from.  512 leaves the whole probe buffer plus both
+					 * strings plus the digits, and this is one record per
+					 * boot. */
+					char record[512];
+					unsigned used = 0, v = err_no;
+					char digits[12];
+					int nd = 0;
+					native_springboard_reported = 1;
+					for (unsigned p = 0; springboard_prefix[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = springboard_prefix[p];
+					}
+					do {
+						if (nd < (int)sizeof(digits)) {
+							digits[nd++] = (char)('0' + (v % 10));
+						}
+						v /= 10;
+					} while (v);
+					while (nd && used < sizeof(record) - 1) {
+						record[used++] = digits[--nd];
+					}
+					/* The full path this caller was handed, byte-scanned.
+					 * If a byte is outside the safe set the path is
+					 * dropped and the record still carries the errno,
+					 * which is the part that answers "did launchd open
+					 * it".  `probe` is NUL-terminated unconditionally
+					 * above, so this loop is bounded. */
+					int path_safe = 1;
+					unsigned plen = 0;
+					for (unsigned i = 0; probe[i]; ++i) {
+						char c = probe[i];
+						if (!((c >= 'a' && c <= 'z')
+							|| (c >= 'A' && c <= 'Z')
+							|| (c >= '0' && c <= '9')
+							|| c == '.' || c == '_' || c == '-' || c == '/')) {
+								path_safe = 0;
+								break;
+							}
+						++plen;
+					}
+					if (path_safe && plen > 0) {
+						for (unsigned p = 0; springboard_path[p]
+							&& used < sizeof(record) - 1; ++p) {
+							record[used++] = springboard_path[p];
+						}
+						for (unsigned i = 0; i < plen
+							&& used < sizeof(record) - 1; ++i) {
+							record[used++] = probe[i];
+						}
+						record[used++] = '"';
+					}
+					for (unsigned p = 0; springboard_suffix[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = springboard_suffix[p];
+					}
+					record[used] = 0;
+					native_console_report(record, used);
+				}
+			}
+
+			/* THE GENERAL RECORD.  Any open under one of the job
+			 * directories, carrying the job's name and the errno.  This is
+			 * what turns "SpringBoard did not spawn" into "launchd opened N
+			 * job files, these are they, and this one failed", which is the
+			 * difference between a defect in launchd's selection and a
+			 * defect in the capture's duration. */
+			if (in_a_job_dir
+			    && native_job_open_records < kMaxJobOpenRecords) {
+				char record[384];
+				unsigned used = 0, blen = 0, n;
+				int safe = base[0] != 0;
+				char digits[12];
+				int nd = 0;
+
+				for (unsigned i = 0; base[i]; ++i) {
+					char c = base[i];
+					if (!((c >= 'a' && c <= 'z')
+					    || (c >= 'A' && c <= 'Z')
+					    || (c >= '0' && c <= '9')
+					    || c == '.' || c == '_' || c == '-')) {
+						safe = 0;
+						break;
+					}
+					++blen;
+				}
+				if (safe && blen > 0 && blen < 100) {
+					unsigned v;
+					++native_job_open_records;
+					n = native_job_open_records;
+					for (unsigned p = 0; job_open_prefix[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = job_open_prefix[p];
+					}
+					v = n;
+					do {
+						if (nd < (int)sizeof(digits)) {
+							digits[nd++] = (char)('0' + (v % 10));
+						}
+						v /= 10;
+					} while (v);
+					while (nd && used < sizeof(record) - 1) {
+						record[used++] = digits[--nd];
+					}
+					for (unsigned p = 0; job_open_middle[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = job_open_middle[p];
+					}
+					for (unsigned i = 0; i < blen
+					    && used < sizeof(record) - 1; ++i) {
+						record[used++] = base[i];
+					}
+					for (unsigned p = 0; job_open_err[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = job_open_err[p];
+					}
+					v = err_no;
+					nd = 0;
+					do {
+						if (nd < (int)sizeof(digits)) {
+							digits[nd++] = (char)('0' + (v % 10));
+						}
+						v /= 10;
+					} while (v);
+					while (nd && used < sizeof(record) - 1) {
+						record[used++] = digits[--nd];
+					}
+					for (unsigned p = 0; job_open_suffix[p]
+					    && used < sizeof(record) - 1; ++p) {
+						record[used++] = job_open_suffix[p];
+					}
+					record[used] = 0;
+					native_console_report(record, used);
+				}
+			}
+		}
+	}
+#endif /* XNU_NATIVE_VIRTIO_CONSOLE */
+
 	kfree_type(typeof(*__open_data), __open_data);
 
 	return error;
